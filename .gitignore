# ---------------------------------------------
# Secrets / environment files (NEVER commit these)
# ---------------------------------------------
.env
.env.local
.env.*.local
backend/.env
backend/.env.*
frontend/.env.local
frontend/.env*.local
*.pem
*.key

# ---------------------------------------------
# Datasets (too large for the repository)
# ---------------------------------------------
# Only the ROOT-level dataset folders are ignored so that backend/app/data/
# (which must commit model.onnx + labels.json, both < 50 MB) stays tracked.
/data/
ml/data/
ml/datasets/
*.csv
*.tsv
!ml/reports/*.csv

# ---------------------------------------------
# Model artifacts (weights > 50 MB must never be committed)
# ---------------------------------------------
*.h5
*.keras
*.pt
*.pth
*.ckpt
*.weights
*.onnx.tmp
# NOTE: backend/app/data/model.onnx MAY be committed if it is under 50 MB,
# so .onnx is not globally ignored. If the final ONNX model is larger than
# 50 MB, uncomment the line below and document where to download it:
# *.onnx
# labels.json is small and is committed, so it is not ignored either.

# ---------------------------------------------
# Python
# ---------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
venv/
env/
.venv/
ENV/
ml/.venv/
backend/.venv/
.venv*

# Testing / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
*.cover

# Jupyter
.ipynb_checkpoints/
ml/notebooks/*.out

# ---------------------------------------------
# Node / Next.js / frontend
# ---------------------------------------------
node_modules/
.pnp
.pnp.js
frontend/out/
frontend/build/
frontend/.next/
frontend/.next/cache/
frontend/next-env.d.ts
frontend/.vercel
.npm
.eslintcache
*.tsbuildinfo

# ---------------------------------------------
# Docker
# ---------------------------------------------
*.pid

# ---------------------------------------------
# IDE / editors
# ---------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.project
.settings/

# ---------------------------------------------
# OS files
# ---------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Backend runtime artifacts
backend/*.db
*.sqlite3
