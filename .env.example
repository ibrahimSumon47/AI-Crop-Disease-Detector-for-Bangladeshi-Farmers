# ------------------------------------------------------------
# AI Crop Disease Detector — environment variables
#
# This file lists EVERY variable the project uses with placeholder
# values. Copy it to a real .env file (NEVER commit the real one!)
#   - Backend:  cp .env.example backend/.env
#   - Frontend: frontend/.env.local (NEXT_PUBLIC_API_URL when needed)
# ------------------------------------------------------------

# ---------------------------------------------------------------------------
# BACKEND_URL — public base URL of the FastAPI backend, no trailing slash.
# Used by the frontend to call /predict, /history etc.
# Dev default; replace with the deployed URL (HF Spaces / Render) later.
# ---------------------------------------------------------------------------
BACKEND_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# DATABASE_URL — SQLAlchemy connection string for the scan history database.
# Default uses a local SQLite file; on Render a Postgres URL can be used,
# for SQLite file lives inside the app container and is reset on redeploy.
# ---------------------------------------------------------------------------
DATABASE_URL=sqlite:///./backend/app/data/scans.db

# ---------------------------------------------------------------------------
# LLM_API_KEY — OPTIONAL. If set, the advice service sends the curated
# Bangla guideline text to an LLM to rewrite it in simpler Bangla.
# The prompt is strictly grounded: the LLM may ONLY rephrase the provided
# guideline and must never invent doses, products, or new advice.
# Leave empty to use the static guideline JSON only (recommended default).
# ---------------------------------------------------------------------------
LLM_API_KEY=

# ---------------------------------------------------------------------------
# CONFIDENCE_THRESHOLD — softmax probability (0..1) below which the API
# refuses to give a diagnosis and returns is_uncertain=true ("consult an
# agriculture officer"). Final value is calibrated on the validation set by
# ml/src/calibrate_threshold.py; 0.97 = calibrated value (ml/reports/threshold.json).
# ---------------------------------------------------------------------------
CONFIDENCE_THRESHOLD=0.97

# ---------------------------------------------------------------------------
# MODEL_PATH — file path of the ONNX model shipped inside the backend.
# The file is produced by ml/src/export_onnx.py after training.
# ---------------------------------------------------------------------------
MODEL_PATH=./backend/app/data/model.onnx

# ---------------------------------------------------------------------------
# ALLOWED_ORIGINS — comma-separated list of browser origins allowed to call
# this backend (CORS). Add your production Vercel domain when deploying.
# ---------------------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# FRONTEND-ONLY (frontend/.env.local)
# Public API base URL, baked into the browser bundle at build time.
# MUST match what backend ALLOWED_ORIGINS permits.
# NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
# ---------------------------------------------------------------------------
