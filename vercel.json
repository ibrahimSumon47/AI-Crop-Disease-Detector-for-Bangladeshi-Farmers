{
  "services": {
    "web": {
      "root": "frontend/"
    },
    "api": {
      "root": ".",
      "entrypoint": "api.index:app",
      "functions": {
        "api/index.py": {
          "includeFiles": "backend/**",
          "memory": 1024,
          "maxDuration": 30
        }
      }
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "api" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}
