# Frontend environment template (frontend/.env.local)
#
# Public base URL of the FastAPI backend, no trailing slash.
# The value is baked into the browser bundle at build time —
# it must match an origin listed in the backend's ALLOWED_ORIGINS.
#
# Dev (api on localhost):
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
#
# Production (after deploying the backend on Render/HF Spaces):
# NEXT_PUBLIC_BACKEND_URL=https://<your-backend-url>
